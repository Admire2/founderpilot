{
    "name":  "kara-desktop",
    "version":  "1.1.0",
    "description":  "Kara Office Sovereign Suite",
    "author":  "FounderPilot",
    "main":  "main.cjs",
    "scripts":  {
                    "start":  "electron .",
                    "build-win":  "electron-builder --win",
                    "build-linux":  "electron-builder --linux AppImage"
                },
    "devDependencies":  {
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3"
                        },
    "build":  {
    "mac": {
      "target": "dmg",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.ico"
    },
                  "appId":  "com.karaoffice.suite",
                  "productName":  "Kara Office",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "extraResources":  [
                                         "docs/**/*"
                                     ],
                  "win":  {
                              "target":  "nsis"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true
                           }
              }
}