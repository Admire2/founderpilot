"use client";
import { useEffect, useState } from "react";
import Link from "next/link";
import { createClient } from "@supabase/supabase-js";

const TAXONOMY: any[] = [
  { name: "Fashion & Clothing", icon: "👗", subs: ["Men", "Women", "Unisex", "Children", "Teenagers"] },
  { name: "Jewelry & Gems", icon: "💍", subs: ["Cufflinks", "Rings", "Necklaces", "Beads", "Custom pieces"] },
  { name: "Fabrics & Textiles", icon: "🧵", subs: ["Aso Oke", "Adire", "Ankara", "Lace", "Plain weaves"] },
  { name: "Art & Crafts", icon: "🎨", subs: ["Wall art", "Sculpture", "Beadwork", "Pottery"] },
  { name: "Home & Living", icon: "🏠", subs: ["Decor", "Kitchen", "Bedding"] },
  { name: "Beauty & Care", icon: "🧴", subs: ["Skincare", "Hair", "Fragrance"] },
];

export default function Market() {
  const [items, setItems] = useState<any[]>([]);
  const [cat, setCat] = useState<string | null>(null);
  const [sub, setSub] = useState<string | null>(null);
  const [cartCount, setCartCount] = useState(0);

  useEffect(() => {
    (async () => {
      try {
        const sb = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!);
        const { data } = await sb.from("kara_listings").select("*");
        setItems((data || []).filter((l: any) => !l.status || l.status === "active"));
      } catch (e) {}
      try { setCartCount(JSON.parse(localStorage.getItem("kara_cart") || "[]").reduce((a: number, c: any) => a + (c.qty || 1), 0)); } catch (e) {}
    })();
  }, []);

  const priceOf = (l: any) => Number(l.price_usd != null ? l.price_usd : l.price) || 0;
  const inCat = cat ? items.filter((l) => l.category === cat) : [];
  const listed = cat ? (sub === "*" || sub === null ? inCat : inCat.filter((l) => l.subcategory === sub)) : [];
  const active = TAXONOMY.find((t) => t.name === cat);

  const add = (l: any) => {
    const p = priceOf(l);
    const item = { id: l.id, listing_id: l.id, title: l.title, price_usd: p, price: p, image_url: l.image_url, seller_id: l.seller_id, qty: 1, it: { title: l.title, price_usd: p, price: p, image_url: l.image_url, seller_id: l.seller_id } };
    const cart = JSON.parse(localStorage.getItem("kara_cart") || "[]");
    const ex = cart.find((c: any) => String(c.id) === String(l.id));
    if (ex) ex.qty = (ex.qty || 1) + 1; else cart.push(item);
    localStorage.setItem("kara_cart", JSON.stringify(cart));
    setCartCount(cart.reduce((a: number, c: any) => a + (c.qty || 1), 0));
  };

  return (
    <main className="min-h-screen bg-slate-950 p-6 text-white">
      <header className="flex flex-wrap items-center justify-between gap-3">
        <Link href="/" className="text-sm text-cyan-400 hover:underline">← Home</Link>
        <nav className="flex items-center gap-4 text-sm">
          <Link href="/karakata/sellers" className="hover:underline">Sellers</Link>
          <Link href="/karakata/build" className="font-bold text-emerald-400 hover:underline">🏗️ Build my store free</Link>
          <Link href="/karakata/checkout" className="rounded-lg bg-emerald-600 px-3 py-1 font-bold hover:bg-emerald-500">🛒 Cart ({cartCount})</Link>
        </nav>
      </header>

      <h1 className="mt-6 text-3xl font-bold">KaraKata Market</h1>
      <p className="mt-1 text-sm text-slate-400">Handpicked sellers · Payments held in escrow until delivery · Reviews from verified purchases only.</p>

      {(cat || sub) && (
        <p className="mt-4 text-sm text-slate-400">
          <button onClick={() => { setCat(null); setSub(null); }} className="text-cyan-400 hover:underline">All categories</button>
          {cat && (<span> / <button onClick={() => setSub(null)} className="text-cyan-400 hover:underline">{cat}</button></span>)}
          {sub && sub !== "*" && (<span> / <span className="text-white">{sub}</span></span>)}
        </p>
      )}

      {!cat && (
        <div className="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
          {TAXONOMY.map((t) => (
            <button key={t.name} onClick={() => { setCat(t.name); setSub(null); }} className="rounded-xl border border-slate-800 bg-slate-900 p-5 text-left hover:border-emerald-500">
              <p className="text-3xl">{t.icon}</p>
              <p className="mt-2 font-bold">{t.name}</p>
              <p className="mt-1 text-xs text-slate-500">{items.filter((l) => l.category === t.name).length} listings · {t.subs.length} subcategories</p>
            </button>
          ))}
        </div>
      )}

      {cat && sub === null && active && (
        <div className="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
          <button onClick={() => setSub("*")} className="rounded-xl border border-emerald-600 bg-emerald-600/10 p-5 text-left hover:bg-emerald-600/20">
            <p className="text-3xl">✨</p>
            <p className="mt-2 font-bold">Everything in {cat}</p>
            <p className="mt-1 text-xs text-slate-400">{inCat.length} listings</p>
          </button>
          {active.subs.map((s: string) => (
            <button key={s} onClick={() => setSub(s)} className="rounded-xl border border-slate-800 bg-slate-900 p-5 text-left hover:border-emerald-500">
              <p className="mt-2 font-bold">{s}</p>
              <p className="mt-1 text-xs text-slate-500">{inCat.filter((l) => l.subcategory === s).length} listings</p>
            </button>
          ))}
        </div>
      )}

      {cat && sub !== null && (
        <div className="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
          {listed.map((l) => (
            <div key={l.id} className="rounded-xl border border-slate-800 bg-slate-900 p-4">
              {l.image_url ? (<img src={l.image_url} alt="" className="h-32 w-full rounded-lg object-cover" />) : (<div className="flex h-32 items-center justify-center rounded-lg bg-slate-800 text-3xl">📦</div>)}
              <p className="mt-3 font-bold">${priceOf(l).toFixed(2)}</p>
              <p className="mt-1 line-clamp-2 text-sm text-slate-300">{l.title}</p>
              <p className="mt-1 text-xs text-slate-500">{l.category}{l.subcategory ? " · " + l.subcategory : ""}</p>
              <button onClick={() => add(l)} className="mt-3 w-full rounded-lg bg-emerald-600 py-2 text-sm font-bold hover:bg-emerald-500">Add to cart</button>
            </div>
          ))}
          {listed.length === 0 && (
            <div className="col-span-2 rounded-xl border border-dashed border-slate-700 p-8 text-center md:col-span-4">
              <p className="font-bold">No listings here yet.</p>
              <p className="mt-1 text-sm text-slate-400">Be the first seller in {sub === "*" ? cat : sub} - photograph your goods and let AI build your store.</p>
              <Link href="/karakata/build" className="mt-3 inline-block rounded-lg bg-emerald-600 px-5 py-2 font-bold hover:bg-emerald-500">🏗️ Build my store free</Link>
            </div>
          )}
        </div>
      )}

      <p className="mt-10 text-xs text-slate-500">Selling elsewhere? <Link className="text-emerald-400 underline" href="/karakata/build">Photograph your shop - AI builds your KaraKata storefront free</Link> · Want perfect listings? <Link className="text-cyan-400 underline" href="/karakata/studio">Seller Studio (2 credits)</Link></p>
    </main>
  );
}